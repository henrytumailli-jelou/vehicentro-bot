      "id": "a1HtRm9kLp2vNw3xQf7Yb",
      "title": "Consultar historial room",
      "configuration": {
        "url": "https://api.jelou.ai/v1/rooms/G:{{$bot.id}}:{{$user.id}}",
        "body": {
