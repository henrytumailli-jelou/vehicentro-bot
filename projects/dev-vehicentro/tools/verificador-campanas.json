    {
      "id": "b2IuSn0mMq3wOx4yRg8Zc",
      "title": "Parsear respuesta room",
      "configuration": {
        "content": "let campaniaResponse = $context.get(\"campaniaResponse\") || {};\nif (typeof campaniaResponse === 'string') {\n  campaniaResponse = JSON.parse(campaniaResponse);\n}\n\nlet data = campaniaResponse.data.data || {};\nif (typeof data === 'string') {\n  data = JSON.parse(data);\n}\nconst msgsUsuario = data.messages || [];\nconst msgUsuario = msgsUsuario[0] || {};\nconst metadata = msgUsuario?.metadata || {};\nconst hasreferral = !!(metadata.referral);\n\n$utils.logger.log(\"campaniaResponse data\", data);\n\nif (hasreferral) {\n  const referral = metadata.referral;\n  $memory.set(\"headline\", referral.headline || \"\");\n  $memory.set(\"source_url\", referral.source_url || \"\");\n}\n\nconst bubble = msgUsuario?.bubble || {};\nconst text = bubble.text || \"\";\n\n$context.set(\"hasreferral\", hasreferral);\n$memory.set(\"text\", text);",
        "instruction": "Extrae referral del historial del room.",
        "memoryVersion": "v2"
      },
      "type": "CODE",
      "position": [
        1257,
        226
      ]
    },
