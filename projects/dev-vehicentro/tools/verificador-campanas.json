          },
          "retryOptions": {
            "enabled": true,
            "retries": 1,
            "retryDelay": "exponential_delay",
            "milliseconds": 0,
            "retryCondition": "is_network_or_idempotent_request_error",
            "shouldResetTimeout": false
          },
          "sslCertificate": true
        },
        "instruction": "Obtiene el historial del room para detectar metadata de referral de campaña.",
        "authentication": {
          "type": "basic",
          "enabled": true,
          "password": "",
          "username": "{{$company.clientId}}",
          "isEncrypted": true
        }
