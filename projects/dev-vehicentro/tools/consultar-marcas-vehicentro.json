      "id": "c8Ln3oRyS2wO4xM6kUgZb",
      "title": "Parsear marcas",
      "configuration": {
        "title": "Parsear marcas",
        "content": "const response = $context.getHttpResponse('marcasResponse');\nlet payload = {};\ntry { payload = response.json(); } catch (e) { throw new Error('Respuesta inválida de veh-bdc'); }\n// veh-bdc responde {ok, tipo, data}; solo \"ok\" trae marcas.\nif (payload.tipo !== 'ok') { throw new Error('Marcas no disponibles: ' + String(payload.tipo || 'sin tipo')); }\nconst marcas = (payload.data || []).map(function (m) { return { id: String(m.id), nombre: String(m.nombre) }; })\n  .filter(function (m) { return m.id && m.nombre; });\nif (marcas.length === 0) { throw new Error('No se encontraron marcas'); }\n$output.set('success', { marcas: marcas, total: marcas.length });",
        "instruction": "Normaliza la respuesta de botwa_marcas y devuelve el listado al agente.",
        "memoryVersion": "v2"
      },
