      "configuration": {
        "title": "Guardar acción crédito",
        "content": "const r = $memory.getJson('creditoResult', {});\nconst accion = (r.accion || 'continuar').toLowerCase();\n$memory.set('accion_credito', accion);\nif (r.tipo_credito) $memory.set('tipo_credito', String(r.tipo_credito));\nif (r.modelo_interes) $memory.set('modelo_interes', String(r.modelo_interes));\nif (accion === 'vehicentro') $memory.set('tipo_credito', 'vehicentro');\nif (accion === 'financieras') $memory.set('tipo_credito', 'financieras');",
        "instruction": "Persiste tipo de crédito seleccionado.",
