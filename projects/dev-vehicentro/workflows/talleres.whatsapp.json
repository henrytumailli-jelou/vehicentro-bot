      "title": "Guardar acción talleres",
      "configuration": {
        "title": "Guardar acción talleres",
        "content": "const r = $memory.getJson('talleresResult', {});\nconst accion = (r.accion || 'continuar').toLowerCase();\n$memory.set('accion_talleres', accion);\nif (r.ciudad) $memory.set('ciudad_usuario', String(r.ciudad));\nif (r.agencia) $memory.set('agencia_seleccionada', String(r.agencia));\nif (r.placa_vehiculo) $memory.set('placa_vehiculo', String(r.placa_vehiculo));\nif (r.fecha_cita) $memory.set('fecha_cita', String(r.fecha_cita));\nif (r.hora_cita) $memory.set('hora_cita', String(r.hora_cita));",
        "instruction": "Persiste datos de agendamiento.",
        "memoryVersion": "v2"
