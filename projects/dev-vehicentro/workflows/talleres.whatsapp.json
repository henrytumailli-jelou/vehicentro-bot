      "id": "llRDVCGkF9mMEMUgaYhaf",
      "title": "Parsear agencias taller",
      "configuration": {
        "title": "Parsear agencias taller",
        "content": "const response = $context.getHttpResponse('agenciasTallerResponse');\nlet data = {};\ntry { data = response.json(); } catch (e) { data = {}; }\nconst items = data.items || data.agencias || data.data || (Array.isArray(data) ? data : []);\n$memory.setJson('agencias_taller', items, 86400);\n$memory.set('agencias_cargadas', items.length > 0 ? 'si' : 'no');",
        "instruction": "Normaliza listado de agencias para el agente.",
        "memoryVersion": "v2"
      },
      "type": "CODE",
