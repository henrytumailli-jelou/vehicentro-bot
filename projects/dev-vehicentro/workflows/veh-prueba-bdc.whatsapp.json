        "title": "Resumen",
        "content": "const leer = (n) => { try { const r = $context.getHttpResponse(n); return r ? r.json() : null; } catch (e) { return null; } };\nconst l = leer('leadResp');\nconst e = leer('estadoResp'), m = leer('marcasResp'), mo = leer('modelosResp');\nconst marcas = (m && m.data) ? m.data.map((x) => x.id + ':' + x.nombre).join(', ') : '-';\nconst n = (mo && Array.isArray(mo.data)) ? mo.data.length : 0;\nconst primero = n ? mo.data[0] : null;\n$memory.set('bdc_resumen', 'estado=' + (e ? e.tipo : 'sin respuesta') + ' | marcas=' + (m ? m.tipo : '-') + ' [' + marcas + '] | modelos(3)=' + (mo ? mo.tipo : '-') + ' n=' + n + (primero ? ' primero=' + primero.id_modelo + ' ' + primero.nombre + ' img=' + primero.imagenes.length : ''));\n$memory.set('bdc_resumen', $memory.get('bdc_resumen') + ' | lead=' + (l ? l.tipo : '-') + ' asesor=' + (l && l.data && l.data.asesor ? 'si, correo=' + (l.data.asesor.correo ? 'si' : 'no') : 'no'));",
